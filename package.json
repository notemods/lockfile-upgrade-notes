{
	"name": "lockfile-upgrade-notes",
	"version": "1.0.4",
	"private": true,
	"description": "Compare two npm lockfiles and save a note with package additions, removals, and version changes.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint . --max-warnings 0 && stylelint \"*.css\" --allow-empty-input --max-warnings 0",
		"test": "vitest run",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test:e2e": "wdio run ./wdio.conf.mts"
	},
	"keywords": [
		"obsidian-plugin"
	],
	"license": "MIT",
	"engines": {
		"node": ">=24",
		"npm": ">=11"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/mocha": "^10.0.10",
		"@types/node": "^22.19.0",
		"@wdio/cli": "^9.32.0",
		"@wdio/globals": "^9.31.3",
		"@wdio/local-runner": "^9.32.0",
		"@wdio/mocha-framework": "^9.32.0",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.13.0",
		"happy-dom": "^20.14.6",
		"jiti": "^2.7.0",
		"obsidian": "^1.14.4",
		"obsidian-launcher": "^3.3.0",
		"obsidian-test-mocks": "^7.2.0",
		"stylelint": "~17.15.0",
		"stylelint-config-obsidianmd": "^0.1.0",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.71.1",
		"vitest": "^5.0.3",
		"wdio-obsidian-reporter": "^3.3.0",
		"wdio-obsidian-service": "^3.3.0",
		"webdriverio": "^9.32.0"
	}
}
