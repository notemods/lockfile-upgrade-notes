{
  "slug": "lockfile-upgrade-notes",
  "module": "products/lockfile-upgrade-notes/src/compare.ts",
  "function": "compareSources",
  "cases": [
    {
      "name": "01 direct patch",
      "args": [
        "{\"lockfileVersion\":3,\"packages\":{\"\":{\"dependencies\":{\"a\":\"^1\"}},\"node_modules/a\":{\"version\":\"1.0.0\"}}}",
        "{\"lockfileVersion\":3,\"packages\":{\"\":{\"dependencies\":{\"a\":\"^1\"}},\"node_modules/a\":{\"version\":\"1.0.1\"}}}"
      ],
      "expected": {
        "ok": true,
        "comparison": {
          "rows": [
            {
              "path": "node_modules/a",
              "name": "a",
              "status": "changed",
              "oldVersion": "1.0.0",
              "newVersion": "1.0.1",
              "direct": true,
              "label": "patch",
              "downgrade": false,
              "reason": ""
            }
          ],
          "unchanged": 0,
          "oldFormat": 3,
          "newFormat": 3
        }
      }
    },
    {
      "name": "02 added and removed",
      "args": [
        "{\"lockfileVersion\":3,\"packages\":{\"\":{},\"node_modules/c\":{\"version\":\"2.0.0\"}}}",
        "{\"lockfileVersion\":3,\"packages\":{\"\":{},\"node_modules/b\":{\"version\":\"1.0.0\"}}}"
      ],
      "expected": {
        "ok": true,
        "comparison": {
          "rows": [
            {
              "path": "node_modules/b",
              "name": "b",
              "status": "added",
              "oldVersion": null,
              "newVersion": "1.0.0",
              "direct": false,
              "label": null,
              "downgrade": false,
              "reason": ""
            },
            {
              "path": "node_modules/c",
              "name": "c",
              "status": "removed",
              "oldVersion": "2.0.0",
              "newVersion": null,
              "direct": false,
              "label": null,
              "downgrade": false,
              "reason": ""
            }
          ],
          "unchanged": 0,
          "oldFormat": 3,
          "newFormat": 3
        }
      }
    },
    {
      "name": "03 integrity and resolved only",
      "args": [
        "{\"lockfileVersion\":3,\"packages\":{\"\":{},\"node_modules/a\":{\"version\":\"1.0.0\",\"integrity\":\"old\",\"resolved\":\"old\"}}}",
        "{\"lockfileVersion\":3,\"packages\":{\"\":{},\"node_modules/a\":{\"version\":\"1.0.0\",\"integrity\":\"new\",\"resolved\":\"new\"}}}"
      ],
      "expected": {
        "ok": true,
        "comparison": {
          "rows": [],
          "unchanged": 1,
          "oldFormat": 3,
          "newFormat": 3
        }
      }
    },
    {
      "name": "04 separate nested paths",
      "args": [
        "{\"lockfileVersion\":3,\"packages\":{\"\":{\"dependencies\":{\"a\":\"*\"}},\"node_modules/a\":{\"version\":\"1.0.0\"},\"node_modules/b/node_modules/a\":{\"version\":\"1.0.0\"}}}",
        "{\"lockfileVersion\":3,\"packages\":{\"\":{},\"node_modules/a\":{\"version\":\"2.0.0\"},\"node_modules/b/node_modules/a\":{\"version\":\"1.1.0\"}}}"
      ],
      "expected": {
        "ok": true,
        "comparison": {
          "rows": [
            {
              "path": "node_modules/a",
              "name": "a",
              "status": "changed",
              "oldVersion": "1.0.0",
              "newVersion": "2.0.0",
              "direct": true,
              "label": "major",
              "downgrade": false,
              "reason": ""
            },
            {
              "path": "node_modules/b/node_modules/a",
              "name": "a",
              "status": "changed",
              "oldVersion": "1.0.0",
              "newVersion": "1.1.0",
              "direct": false,
              "label": "minor",
              "downgrade": false,
              "reason": ""
            }
          ],
          "unchanged": 0,
          "oldFormat": 3,
          "newFormat": 3
        }
      }
    },
    {
      "name": "05 scoped package",
      "args": [
        "{\"lockfileVersion\":3,\"packages\":{\"\":{},\"node_modules/@scope/name\":{\"version\":\"1.0.0\"}}}",
        "{\"lockfileVersion\":3,\"packages\":{\"\":{\"dependencies\":{\"@scope/name\":\"*\"}},\"node_modules/@scope/name\":{\"version\":\"1.0.1\"}}}"
      ],
      "expected": {
        "ok": true,
        "comparison": {
          "rows": [
            {
              "path": "node_modules/@scope/name",
              "name": "@scope/name",
              "status": "changed",
              "oldVersion": "1.0.0",
              "newVersion": "1.0.1",
              "direct": true,
              "label": "patch",
              "downgrade": false,
              "reason": ""
            }
          ],
          "unchanged": 0,
          "oldFormat": 3,
          "newFormat": 3
        }
      }
    },
    {
      "name": "06 lock v2 to v3",
      "args": [
        "{\"lockfileVersion\":2,\"packages\":{\"\":{},\"node_modules/a\":{\"version\":\"1.0.0\"}}}",
        "{\"lockfileVersion\":3,\"packages\":{\"\":{},\"node_modules/a\":{\"version\":\"1.1.0\"}}}"
      ],
      "expected": {
        "ok": true,
        "comparison": {
          "rows": [
            {
              "path": "node_modules/a",
              "name": "a",
              "status": "changed",
              "oldVersion": "1.0.0",
              "newVersion": "1.1.0",
              "direct": false,
              "label": "minor",
              "downgrade": false,
              "reason": ""
            }
          ],
          "unchanged": 0,
          "oldFormat": 2,
          "newFormat": 3
        }
      }
    },
    {
      "name": "07 version 1",
      "args": [
        "{\"lockfileVersion\": 1, \"dependencies\": {}}",
        "{\"lockfileVersion\":3,\"packages\":{\"\":{}}}"
      ],
      "expected": {
        "ok": false,
        "error": "Unsupported format: use npm lockfile version 2 or 3."
      }
    },
    {
      "name": "07 malformed JSON",
      "args": [
        "{broken",
        "{\"lockfileVersion\":3,\"packages\":{\"\":{}}}"
      ],
      "expected": {
        "ok": false,
        "error": "Parse error: input is not valid JSON."
      }
    },
    {
      "name": "07 missing packages",
      "args": [
        "{\"lockfileVersion\": 3}",
        "{\"lockfileVersion\":3,\"packages\":{\"\":{}}}"
      ],
      "expected": {
        "ok": false,
        "error": "Unsupported format: packages must be an object."
      }
    },
    {
      "name": "08 link unchanged version is unsupported",
      "args": [
        "{\"lockfileVersion\":3,\"packages\":{\"\":{},\"node_modules/a\":{\"version\":\"1.0.0\",\"link\":true}}}",
        "{\"lockfileVersion\":3,\"packages\":{\"\":{},\"node_modules/a\":{\"version\":\"1.0.0\"}}}"
      ],
      "expected": {
        "ok": true,
        "comparison": {
          "rows": [
            {
              "path": "node_modules/a",
              "name": "a",
              "status": "unsupported",
              "oldVersion": "1.0.0",
              "newVersion": "1.0.0",
              "direct": false,
              "label": null,
              "downgrade": false,
              "reason": "Old entry is a link"
            }
          ],
          "unchanged": 0,
          "oldFormat": 3,
          "newFormat": 3
        }
      }
    },
    {
      "name": "08 missing versions in both maps",
      "args": [
        "{\"lockfileVersion\":3,\"packages\":{\"\":{},\"node_modules/a\":{}}}",
        "{\"lockfileVersion\":3,\"packages\":{\"\":{},\"node_modules/a\":{}}}"
