          "rows": [
            {
              "path": "node_modules/a",
              "name": "a",
              "status": "unsupported",
              "oldVersion": null,
              "newVersion": null,
              "direct": false,
              "label": null,
              "downgrade": false,
              "reason": "Old entry has no version; New entry has no version"
            }
          ],
          "unchanged": 0,
          "oldFormat": 3,
          "newFormat": 3
        }
      }
    },
